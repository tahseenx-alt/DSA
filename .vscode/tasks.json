{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run C++",
            "type": "shell",
            "command": "mkdir -p \"${workspaceFolder}/Trash\" && g++ -std=c++17 \"${file}\" -o \"${workspaceFolder}/Trash/${fileBasenameNoExtension}\" && \"${workspaceFolder}/Trash/${fileBasenameNoExtension}\" < \"${workspaceFolder}/Input.txt\" > \"${workspaceFolder}/Output.txt\"",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}